{
    "name":  "Accessibility Pack",
    "version":  "1.3.1",
    "author":  "no-asteroids-mods",
    "description":  "Colour-blind-safe ore palettes, ore patterns, glow halo strength, UI and text scaling. Press F10 in game for settings.",
    "scripts":  [
                    "palettes.js",
                    "panel.js"
                ],
    "styles":  [
                   "panel.css"
               ],
    "patches":  [
                    {
                        "id":  "prelude",
                        "file":  "/assets/index-*.js",
                        "prepend":  "palettes.js"
                    },
                    {
                        "id":  "glow-ice",
                        "file":  "/assets/index-*.js",
                        "find":  "glow:[`#7cc4ff`",
                        "replace":  "glow:[self.__naA11y.c(`ice`,`glow`,`#7cc4ff`)",
                        "expect":  1
                    },
                    {
                        "id":  "glow-crystal",
                        "file":  "/assets/index-*.js",
